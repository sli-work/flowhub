# ============ FlowHub Backend 环境配置（复制为 .env 后填写） ============

# 应用
APP_ENV=dev
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string
ACCESS_TOKEN_EXPIRE_MINUTES=720
CORS_ORIGINS=http://localhost:5173,http://localhost:5273
# 企业应用页面的 HTTPS 地址（须同时配置到钉钉/企微可信域名和 OAuth 回调白名单）
FLOWHUB_PUBLIC_BASE_URL=https://flowhub.example.com

# ---------- PostgreSQL ----------
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_USER=flowhub
POSTGRES_PASSWORD=flowhub
POSTGRES_DB=flowhub
# 连接串（优先于上述单项）
DATABASE_URL=postgresql+psycopg://flowhub:flowhub@127.0.0.1:5432/flowhub

# ---------- Redis ----------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_DB=0
REDIS_PASSWORD=
REDIS_URL=redis://127.0.0.1:6379/0

# ---------- MinIO（文件存储） ----------
MINIO_ENDPOINT=127.0.0.1:9000
MINIO_ACCESS_KEY=flowhub
MINIO_SECRET_KEY=flowhub-minio
MINIO_BUCKET=flowhub-docs
MINIO_SECURE=false

# 管理员引导（首次启动自动创建）
BOOTSTRAP_ADMIN_ACCOUNT=admin
BOOTSTRAP_ADMIN_PASSWORD=Admin@123456
BOOTSTRAP_ADMIN_NAME=系统管理员

# ---------- 通知渠道 ----------
# 钉钉内部应用：组织同步与点对点工作通知共用 AppKey/AppSecret，AgentId 来自应用详情。
DINGTALK_APP_KEY=
DINGTALK_APP_SECRET=
DINGTALK_AGENT_ID=
# 企业微信：通讯录同步 Secret 与自建应用消息 Secret 请分别配置。
WECOM_CORP_ID=
WECOM_CORP_SECRET=
WECOM_APP_SECRET=
WECOM_AGENT_ID=
# 下列机器人仅用于群广播兜底，不用于点对点通知。
DINGTALK_WEBHOOK=
DINGTALK_SECRET=
WECOM_WEBHOOK=
